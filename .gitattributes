# Resume Engine Repository .gitattributes

# Set default behavior to automatically detect text files and normalize line endings
* text=auto

# Explicitly declare text files to always be normalized and use LF
*.md text
*.yml text
*.json text
*.tex text
*.sty text
*.ps1 text
*.cff text
*.py text
*.sh text eol=lf

# Treat PDFs as binary
*.pdf binary
