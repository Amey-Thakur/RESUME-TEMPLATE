# resume_data.json is committed on purpose. It is your content, it lives in
# your own repository, and GitHub Actions cannot build your PDFs without it.
# The copy in this template is a worked example with invented details.

# Generated files (rebuilt by scripts/generate_latex.py)
resume/configuration/metadata.tex
resume/sections/
resume/source/cover_letter.tex

# Compiled output (rebuilt by scripts/build.sh or scripts/build.ps1)
output/

# Python bytecode from the pre-processor
__pycache__/
*.py[cod]

# LaTeX intermediates
.tectonic/
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
