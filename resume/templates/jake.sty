%-------------------------------------------------------------------------
% jake.sty
% The second of the two resume layouts: the dense single-column format that
% r/EngineeringResumes recommends by default, popularised by Jake Gutierrez's
% LaTeX template.
%
% This is a layout, not a second content pipeline. It loads base.sty and then
% redefines only what is visually different, so both styles are driven by the
% same resume_data.json and the same generated section files. Fill the JSON in
% once and you can compile either look without touching the content.
%
% What changes, and why:
%
%   Type size      10pt rather than 11pt, and no extra leading. The format
%                  exists to fit an internship history, several projects and a
%                  skills block on one page.
%   Margins        Wider text block, 0.5in each side. This is where most of the
%                  extra capacity comes from.
%   Headings       Small caps with the rule immediately under them, tight.
%   Header         Name, then a single contact line. No tagline: in this layout
%                  the space belongs to evidence.
%   Lists          Tighter throughout.
%
% What deliberately does not change: the entry macros, the bullet macros and
% the labelled-line macro all keep their names and their argument order. That
% is the contract the pre-processor writes against, and breaking it would mean
% maintaining two generators.
%-------------------------------------------------------------------------
\ProvidesPackage{jake}[2026/08/31 Dense single-column resume layout]

\RequirePackage{../templates/base}

%---------- Page ----------------------------------------------------------
% base.sty set 0.6in and 0.7in. This layout runs the text block wider and
% closer to the top, which is the whole source of its extra capacity.
\geometry{
  letterpaper,
  top=0.45in,
  bottom=0.45in,
  left=0.5in,
  right=0.5in,
  footskip=0.2in
}

%---------- Vertical rhythm ----------------------------------------------
% No extra leading. base.sty adds 4 percent for the airier style; this one
% wants the lines back.
\linespread{1.0}\selectfont

% Keep a role and its first bullet together. A heading stranded at the foot of
% the page is the most common way this layout goes wrong once it is full.
\widowpenalty=10000
\clubpenalty=10000

%---------- Section headings ---------------------------------------------
% The rule sits directly under the heading. Spacing is declared through
% titlesec rather than corrected with negative \vspace, for the reason base.sty
% gives: a negative correction that looks right at one size collides at
% another, and this layout is the one people push until it is full.
\titleformat{\section}
  {\normalfont\large\scshape\raggedright}
  {}{0em}
  {}
  [{\vspace{2pt}\hrule height 0.6pt}]

\titlespacing*{\section}{0pt}{9pt}{5pt}

%---------- Lists ---------------------------------------------------------
\setlist[entries]{
  label={},
  leftmargin=0pt,
  topsep=2pt,
  parsep=0pt,
  partopsep=0pt,
  itemsep=5pt
}

\setlist[bullets]{
  label=\textbullet,
  leftmargin=0.15in,
  topsep=1pt,
  parsep=0pt,
  partopsep=0pt,
  itemsep=1pt,
  rightmargin=0pt
}

\setlist[labelled]{
  label={},
  leftmargin=0pt,
  topsep=1pt,
  parsep=0pt,
  partopsep=0pt,
  itemsep=1.5pt
}

%---------- Header --------------------------------------------------------
% Name, contact line, links. The tagline is dropped: this layout trades every
% decorative line for one more bullet, and a tagline repeats what the first
% role already says.
\renewcommand{\makeHeader}{%
  \begin{center}
    {\Huge\scshape\myName}\\[2pt]
    {\small\myContactLine}\\[1pt]
    {\small\myLinkLine}
  \end{center}
  \vspace{2pt}
}

%---------- Entry rows ----------------------------------------------------
% Same names and same argument order as base.sty, so the generated sections
% compile unchanged. Only the internal spacing is tightened.
\renewcommand{\entryTwoLine}[4]{%
  \item
  \begin{tabularx}{\linewidth}{@{}X@{\hspace{\entryGutter}}r@{}}
    \textbf{#1} & #2 \\
    \textit{\small #3} & \textit{\small #4} \\
  \end{tabularx}%
  \vspace{1pt}
}

\renewcommand{\entryOneLine}[2]{%
  \item
  \begin{tabularx}{\linewidth}{@{}X@{\hspace{\entryGutter}}r@{}}
    #1 & #2 \\
  \end{tabularx}%
  \vspace{1pt}
}
