%-------------------------------------------------------------------------
% resume.sty
% The resume document. Everything shared with the cover letter lives in
% base.sty; only what is specific to a resume belongs here.
%-------------------------------------------------------------------------
\ProvidesPackage{resume}[2026/08/15 Resume document style]

% Loaded by relative path because the document is compiled from resume/source
% and these packages are not installed in the TeX tree.
\RequirePackage{../templates/base}

% A resume is read in one pass and should not break a role across pages when
% it can be avoided.
\widowpenalty=10000
\clubpenalty=10000

% A little extra leading. A resume is skimmed, and lines set tight are the
% first thing a reader gives up on.
\linespread{1.04}\selectfont
