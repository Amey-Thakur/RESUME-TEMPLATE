%-------------------------------------------------------------------------
% cover_letter.sty
% The cover letter document. Everything shared with the resume lives in
% base.sty; only what is specific to a letter belongs here.
%-------------------------------------------------------------------------
\ProvidesPackage{cover_letter}[2026/08/15 Cover letter document style]

\RequirePackage{../templates/base}

% A letter reads as prose, so paragraphs are separated by space rather than
% indented, and the text is set with a little more room to breathe.
\setlength{\parskip}{9pt}
\linespread{1.05}\selectfont

% Ragged right, not justified. Justification opens rivers of white space in a
% narrow measure, and the stretched inter-word spacing it uses to close the
% line is what comes out wrong when a tracking system extracts the text.
\raggedright

% One paragraph of the letter body. Using a command rather than raw text keeps
% the spacing identical between paragraphs no matter what the generator emits.
\newcommand{\letterPara}[1]{#1\par}

% The recipient block, which tolerates any of its lines being empty.
\newcommand{\letterRecipient}[3]{%
  \begingroup
  \setlength{\parskip}{0pt}%
  \ifx\relax#1\relax\else#1\par\fi
  \ifx\relax#2\relax\else#2\par\fi
  \ifx\relax#3\relax\else#3\par\fi
  \endgroup
}
